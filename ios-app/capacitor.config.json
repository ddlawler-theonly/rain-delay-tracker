{
  "appId": "com.blueworksfieldpro.raindelay",
  "appName": "Rain Out",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0B2E4F",
    "appendUserAgent": "RainOut/1.0.0 (+https://ddlawler-theonly.github.io/rain-delay-tracker/support.html)"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 800,
      "backgroundColor": "#0B2E4F",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    },
    "LocalNotifications": {
      "iconColor": "#0B5CAD"
    }
  }
}
