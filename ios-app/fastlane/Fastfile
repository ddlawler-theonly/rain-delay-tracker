require 'json'
require 'base64'
default_platform(:ios)

ROOT = ['raindelay.config.json', '../raindelay.config.json'].map { |p| File.expand_path(p) }.find { |p| File.exist?(p) }.then { |p| File.dirname(p) }
CFG  = JSON.parse(File.read(File.join(ROOT, 'raindelay.config.json')))
PROJECT = File.join(ROOT, 'ios/App/App.xcodeproj')
DIST_CERT_ID = ENV['DIST_CERT_ID'] || '3FZNU7Q5FT'   # public cert id (not a secret); its p12 is in repo secrets

platform :ios do
  desc 'Build, sign (reusable distribution cert from repo secrets + App Store profile) and upload to TestFlight (SKIP_UPLOAD=1: sign check only). Never submits for review.'
  lane :beta do
    key_id    = ENV.fetch('APP_STORE_CONNECT_KEY_ID')
    issuer_id = ENV.fetch('APP_STORE_CONNECT_ISSUER_ID')
    team_id   = ENV.fetch('APPLE_TEAM_ID')
    key_path  = File.join(ROOT, 'fastlane', "AuthKey_#{key_id}.p8")
    File.write(key_path, ENV.fetch('APP_STORE_CONNECT_KEY'))   # p8 contents from the secret; deleted at the end

    api_key = app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path, duration: 1200, in_house: false)
    setup_ci if ENV['CI']   # temporary keychain on the runner

    # Build number: one above the latest TestFlight build for this version (or the CI run number, whichever is larger)
    latest = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: CFG['bundleId'], version: CFG['version'], initial_build_number: 0)
    rescue StandardError => e
      UI.important("Could not read latest TestFlight build (#{e.message}); starting at 1")
      0
    end
    build_number = [latest.to_i + 1, ENV['GITHUB_RUN_NUMBER'].to_i].max

    auth = "-authenticationKeyPath #{key_path} -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"

    # Signing: manual. ONE reusable Apple Distribution cert (DIST_CERT_ID) lives in the DIST_CERT_P12_BASE64 /
    # DIST_CERT_P12_PASSWORD repo secrets and is imported into the temporary CI keychain, so runs never create certs.
    # get_provisioning_profile reuses the 'com.blueworksfieldpro.raindelay AppStore' profile that contains that cert
    # (and only regenerates it if it is missing/invalid).
    p12_b64 = ENV['DIST_CERT_P12_BASE64'].to_s
    UI.user_error!('Missing repo secret DIST_CERT_P12_BASE64 (reusable distribution cert)') if p12_b64.empty?
    p12_path = File.join(ROOT, 'fastlane', 'dist.p12')
    File.binwrite(p12_path, Base64.decode64(p12_b64)); File.chmod(0o600, p12_path)
    import_certificate(certificate_path: p12_path, certificate_password: ENV.fetch('DIST_CERT_P12_PASSWORD'),
                       keychain_name: 'fastlane_tmp_keychain', keychain_password: '')
    get_provisioning_profile(api_key: api_key, app_identifier: CFG['bundleId'], cert_id: DIST_CERT_ID)
    profile = lane_context[SharedValues::SIGH_NAME]
    update_code_signing_settings(path: PROJECT, targets: ['App'], use_automatic_signing: false, team_id: team_id,
                                 code_sign_identity: 'Apple Distribution', profile_name: profile, bundle_identifier: CFG['bundleId'])

    build_app(
      project: PROJECT, scheme: 'App', configuration: 'Release', clean: true,
      export_method: 'app-store', output_directory: File.join(ROOT, 'build'), output_name: 'RainDelay.ipa',
      # (gym passes xcargs to -exportArchive too, so the auth flags appear only here)
      xcargs: "#{auth} MARKETING_VERSION=#{CFG['version']} CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: { method: 'app-store', signingStyle: 'manual', teamID: team_id, uploadSymbols: true,
                        manageAppVersionAndBuildNumber: false, provisioningProfiles: { CFG['bundleId'] => profile } }
    )

    if ENV['SKIP_UPLOAD'] == '1'
      UI.success("Sign check only: signed IPA built (#{CFG['version']} (#{build_number})); NOT uploaded to TestFlight")
      next
    end
    upload_to_testflight(
      api_key: api_key, app_identifier: CFG['bundleId'],
      skip_waiting_for_build_processing: true,   # internal testers get it automatically once Apple finishes processing
      changelog: ENV['TESTFLIGHT_CHANGELOG'] || "Rain Out #{CFG['version']} (#{build_number})"
    )
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
    File.delete(p12_path) if p12_path && File.exist?(p12_path)
  end
end
